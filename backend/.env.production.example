# Production / staging environment for the API (Render). PLACEHOLDERS ONLY: set the real values in the Render
# dashboard (Environment). Never commit a filled-in copy of this file. See docs/deployment-runbook.md.
# The API refuses to start in production if a REQUIRED value is missing or unsafe (app/config.py production_problems).

# ---- REQUIRED ---------------------------------------------------------------------------------------------
ENVIRONMENT=production
API_PREFIX=/api
# 64+ random characters (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`). Rotating it signs everyone out.
SECRET_KEY=<generate-a-random-48+-char-secret>
# MongoDB Atlas connection string for a database user limited to this database (readWrite on MONGODB_DB only).
MONGODB_URI=mongodb+srv://<app-user>:<password>@<cluster>.mongodb.net
MONGODB_DB=autopilot
# https origins only (no localhost, no trailing slash): the public frontend. Also feeds the Origin/CSRF check.
CORS_ORIGINS=https://<your-frontend-domain>
PUBLIC_SITE_URL=https://<your-frontend-domain>
# Edge proof: the website signs every proxied /api request with this secret. 48+ random characters, SAME value as
# EDGE_SHARED_SECRET on Vercel (a server-side variable, never NEXT_PUBLIC_). Rotate by setting the new value here and the old one
# in EDGE_SHARED_SECRET_PREVIOUS, redeploying both sides, then removing the old one.
EDGE_SHARED_SECRET=<generate-a-random-48+-char-secret>
# Refuse requests that did not come through the website. Set to true only after staging-check.mjs --expect-edge-proof passes.
REQUIRE_EDGE_PROOF=false
# Proxies that append to X-Forwarded-For for a direct request (no valid edge proof): Render's load balancer = 1.
# Confirm on staging (GET /api/diag/request as the platform owner must show YOUR public IP as clientIp when called directly).
TRUSTED_PROXY_HOPS=1
# Per-IP counters in MongoDB (shared by every instance). "memory" needs SINGLE_INSTANCE=true.
RATE_LIMIT_BACKEND=auto
# Simulated money modules: off | invited | all. Production refuses "all" without ALLOW_PUBLIC_SIMULATED_MODULES=true.
SIMULATED_MODULES=invited
# Legal text versions recorded when users accept; "draft-..." means not reviewed by a lawyer. Bump when the text changes.
# TERMS_VERSION=draft-2026-11-14   PRIVACY_VERSION=draft-2026-11-14
# Account deletion grace period (days) and the PLACEHOLDER retention (years) for kept financial/contract records.
# DELETION_GRACE_DAYS=14   FINANCIAL_RETENTION_YEARS=7
# Comma-separated emails of the platform owner(s).
OWNER_EMAILS=<you@yourdomain>

# ---- REQUIRED FOR A REAL LAUNCH (the API starts without them but logs a warning for each) ---------------------
# Email (password reset, verification codes, invites): one of
RESEND_API_KEY=<resend-api-key>
RESEND_FROM=Autopilot <no-reply@<your-verified-domain>>
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASSWORD= / SMTP_FROM=
EMAIL_VERIFICATION=true
# AI drafting (Groq). Without it proposal drafts use the built-in template.
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
# Inbound Upwork alert emails (provider posts to POST /api/inbox/inbound with this secret as a Bearer token).
INBOUND_EMAIL_DOMAIN=<inbound.yourdomain>
INBOUND_EMAIL_WEBHOOK_SECRET=<random-32+-char-secret>
INBOUND_EMAIL_PLATFORMS=Upwork
# Error reporting.
SENTRY_DSN=<backend-sentry-dsn>

# ---- OPTIONAL ----------------------------------------------------------------------------------------------
# Only if real payment processing is wanted and approved (docs/payments.md): without them checkout returns 503.
# STRIPE_SECRET_KEY=<sk_live_...>      STRIPE_WEBHOOK_SECRET=<whsec_...>
# Stored-token encryption (Fernet key) if any stored OAuth token feature is used.
# TOKEN_ENCRYPTION_KEY=<fernet-key>
# Social sign-in apps: GOOGLE_/GITHUB_/MICROSOFT_/APPLE_ CLIENT_ID and CLIENT_SECRET (docs/social-sign-in.md)
# Nango/Outlook inbox read: NANGO_SECRET_KEY, NANGO_WEBHOOK_SIGNING_KEY, NANGO_INTEGRATIONS, OUTLOOK_INBOX_READ_APPROVED=true
# RATE_LIMIT_PER_MINUTE=900 (per client IP; floor 60)

# ---- MUST STAY OFF / UNSET IN PRODUCTION -------------------------------------------------------------------
# SEED_DEMO_DATA            (one shared demo dataset for every account: refused in production)
# ENABLE_DIAG_SLEEP=true    (staging measurements only: refused in production)
# COOKIE_SECURE=false       (refused in production)

# Keep real financial activity disabled for this release.
PAYMENTS_CRYPTO_ENABLED=false
TOKEN_PROGRAM_ENABLED=false
TOKEN_MAINNET_ENABLED=false
# Leave STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET unset for a demo.
