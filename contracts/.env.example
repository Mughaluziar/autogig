# Copy to .env (never commit .env). Only Base Sepolia is configured; there is no mainnet entry.

# --- Network / deployer (Base Sepolia, chainId 84532) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Throwaway testnet EOA that pays gas. It holds NO role after deployment.
DEPLOYER_PRIVATE_KEY=
# Optional: for `npx hardhat verify --network baseSepolia ...`
BASESCAN_API_KEY=

# --- Roles ---
# Safe multisig that receives owner + agent on everything. Must already be deployed
# on Base Sepolia (the script checks for contract code; ownership transfer is single-step).
SAFE_ADDRESS=
# Set to true only for a throwaway test where SAFE_ADDRESS is not a contract.
ALLOW_SAFE_WITHOUT_CODE=false

# --- Token ---
TOKEN_NAME=Pool Share Token
TOKEN_SYMBOL=POOLS
# Decimals are fixed at 6 (1 raw unit = 1 ledger share unit). Not configurable.

# Allowed investor jurisdictions, ISO-3166 numeric codes, comma separated.
# Mirror CAPITAL_INVESTOR_JURISDICTIONS. Examples: 840=US, 826=GB, 276=DE, 250=FR, 124=CA.
ALLOWED_COUNTRIES=840

# Optional SupplyLimitModule cap in RAW units (6 decimals). Empty = module not deployed.
# Example: 5000000000000 = 5,000,000 shares.
SUPPLY_LIMIT=

# CREATE2 salt for TREXFactory.deployTREXSuite (must be unique per suite). Default: <SYMBOL>-pool-share-v1
TREX_SALT=

# --- Recorded in deployments/<network>.json only (the contracts never touch USDC) ---
# Circle USDC on Base Sepolia (developers.circle.com/stablecoins/usdc-contract-addresses):
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
