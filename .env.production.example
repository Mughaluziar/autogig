# Frontend environment for the production deploy (Vercel -> Project Settings -> Environment Variables, Production).
# PLACEHOLDERS ONLY. See docs/deployment-runbook.md. A Vercel production build FAILS (scripts/deploy-guards.mjs) if
# BACKEND_API_URL is missing or not https, if EDGE_SHARED_SECRET is missing or short, or if NEXT_PUBLIC_DEV_BYPASS_AUTH is true.

# The API's https URL. /api/* is proxied to it by next.config.mjs, so the session cookie is first-party.
BACKEND_API_URL=https://<your-api>.onrender.com
# Edge proof (middleware.ts): the same 48+ character random value as EDGE_SHARED_SECRET on the API. Server-side only:
# NEVER prefix it with NEXT_PUBLIC_ (that would publish it to every browser). Never commit it.
EDGE_SHARED_SECRET=<same-random-value-as-on-the-api>
# Leave unset in production (it signs every visitor in as an admin).
# NEXT_PUBLIC_DEV_BYPASS_AUTH=false
# Optional error reporting.
# NEXT_PUBLIC_SENTRY_DSN=<frontend-sentry-dsn>
# Only for a deliberate frontend-only DEMO site (mock data, no sign-in); never for the real product:
# ALLOW_FRONTEND_ONLY_DEMO=true
